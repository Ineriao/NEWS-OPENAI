# =====================================================
# Git Ignore - 新闻发布系统
# =====================================================

# 环境变量文件 (包含敏感信息)
.env
*.env.local

# IDE
.idea/
*.iml
.vscode/

# 编译输出
target/
build/
dist/
*.class
*.jar
*.war

# 日志文件
*.log
logs/

# 操作系统
.DS_Store
Thumbs.db

# Node.js
node_modules/

# 临时文件
*.tmp
*.temp
*.swp

# 上传文件目录
uploads/
