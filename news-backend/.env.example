# =====================================================
# 新闻发布系统 - 环境变量配置模板
# =====================================================
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# 数据库配置
DB_USERNAME=root
DB_PASSWORD=your_database_password

# JWT 配置
JWT_SECRET=YourSuperSecretKeyForJWTTokenGenerationMustBeLongEnough123456

# 文件上传路径
UPLOAD_PATH=D:/uploads/news/

# AI 配置 (支持 Kimi/DeepSeek/OpenAI)
AI_API_KEY=your-api-key-here
AI_BASE_URL=https://api.moonshot.cn/v1
AI_MODEL=moonshot-v1-8k
